APP_NAME=SIMAK Mobile Dev

# BASE_URL Options:
# - Local iOS Simulator / macOS: http://localhost:8080/api/mobile/v1
# - Local Android Emulator: http://10.0.2.2:8080/api/mobile/v1
# - Local Real Device: http://192.168.x.x:8080/api/mobile/v1 (Ganti IP komputer Anda)
# - Dev Server: https://api-dev.simak.ac.id/v1
BASE_URL=http://localhost:8080/api/mobile/v1

API_TIMEOUT=30000

# Set USE_DUMMY=false untuk konek langsung ke Backend Spring Boot
# Set USE_DUMMY=true untuk menggunakan mock/dummy data internal
USE_DUMMY=false
ENABLE_LOG=true
